#!/usr/bin/env python3
import argparse
import os
import shutil
import subprocess
import sys
import time
from typing import TextIO


def output(message: str, color: str, stream: TextIO = sys.stdout) -> None:
    if stream.isatty() and "NO_COLOR" not in os.environ:
        message = f"\033[{color}m{message}\033[0m"
    print(message, file=stream, flush=True)


def status(message: str, color: str = "36") -> None:
    output(f"  {message}", color)


def error(message: str) -> None:
    output(message, "31", sys.stderr)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Control my Android phone from this Mac."
    )
    subparsers = parser.add_subparsers(dest="action", required=True)
    mirror = subparsers.add_parser("mirror", help="Unlock and open screen mirroring")
    mirror.add_argument(
        "--quality",
        choices=("low", "medium", "high"),
        default="medium",
        help="Video quality (default: medium)",
    )
    subparsers.add_parser("unlock", help="Wake and unlock the phone")
    subparsers.add_parser("lock", help="Turn off the phone screen")
    return parser.parse_args()


def check_dependencies(action: str) -> None:
    for program in ("adb", "scrcpy") if action == "mirror" else ("adb",):
        if not shutil.which(program):
            error(f"{program} is missing.")
            sys.exit(1)


def get_phone_address() -> str:
    address = os.environ.get("ANDROID_ADB_ADDRESS")
    if not address:
        error("ANDROID_ADB_ADDRESS is missing.")
        sys.exit(1)
    return address


def connect_phone(address: str) -> None:
    status("Connecting to your phone...")
    subprocess.run(["adb", "connect", address], check=True)
    subprocess.run(["adb", "-s", address, "wait-for-device"], check=True)


def lock_phone(address: str) -> None:
    status("Turning off the screen...")
    subprocess.run(
        ["adb", "-s", address, "shell", "input", "keyevent", "KEYCODE_SLEEP"],
        check=True,
    )
    status("Screen turned off.", "32")


def unlock_phone(address: str) -> None:
    adb = ["adb", "-s", address]
    status("Waking the screen...")
    subprocess.run(adb + ["shell", "input", "keyevent", "KEYCODE_WAKEUP"], check=True)
    time.sleep(1.5)
    policy = subprocess.run(
        adb + ["shell", "dumpsys", "window", "policy"],
        check=True,
        capture_output=True,
        text=True,
    ).stdout
    if "showing=true" in policy:
        pin = os.environ.get("ANDROID_PIN")
        if not pin or not pin.isascii() or not pin.isdigit():
            error("ANDROID_PIN is missing or is not a numeric PIN.")
            sys.exit(1)
        status("Unlocking your phone...")
        subprocess.run(
            adb + ["shell", "input", "swipe", "500", "2100", "500", "700", "400"],
            check=True,
        )
        time.sleep(1)
        subprocess.run(adb + ["shell", "input", "text", pin], check=True)
        subprocess.run(
            adb + ["shell", "input", "keyevent", "KEYCODE_ENTER"], check=True
        )
    else:
        status("Phone is already unlocked.", "32")


def mirror_phone(address: str, quality: str) -> None:
    quality_options = {
        "low": ["--max-size=640", "--video-bit-rate=500K", "--max-fps=30"],
        "medium": ["--max-size=960", "--video-bit-rate=800K", "--max-fps=40"],
        "high": ["--max-size=1600", "--video-bit-rate=2M", "--max-fps=60"],
    }
    status("Opening scrcpy. The screen will turn off when you close it.", "32")
    os.execvp(
        "scrcpy",
        [
            "scrcpy",
            "--serial",
            address,
            "--video-codec=h265",
            *quality_options[quality],
            "--power-off-on-close",
        ],
    )


def main() -> None:
    args = parse_args()
    check_dependencies(args.action)
    address = get_phone_address()
    connect_phone(address)

    if args.action == "lock":
        lock_phone(address)
        return

    unlock_phone(address)
    if args.action == "mirror":
        mirror_phone(address, args.quality)


if __name__ == "__main__":
    try:
        main()
    except subprocess.CalledProcessError as exc:
        error(f"Command failed (exit {exc.returncode}).")
        sys.exit(exc.returncode or 1)
