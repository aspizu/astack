keybinds {
    unbind "Alt f"
    shared_except "locked" {
        bind "Ctrl q" { Detach; }
    }
    scroll {
        unbind "Alt right"
        bind "Alt h" "Alt left" { MoveFocusOrTab "left"; SwitchToMode "normal"; }
        bind "Alt j" "Alt down" { MoveFocus "down"; SwitchToMode "normal"; }
        bind "Alt k" "Alt up" { MoveFocus "up"; SwitchToMode "normal"; }
        bind "Alt l" { MoveFocusOrTab "right"; SwitchToMode "normal"; }
    }
}

theme "catppuccin-mocha"
session_serialization false
show_startup_tips false
